terraform {
  required_version = ">= 1.5.0"

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
    archive = {
      source  = "hashicorp/archive"
      version = "~> 2.4"
    }
    random = {
      source  = "hashicorp/random"
      version = "~> 3.6"
    }
  }

  # Not configured with a remote backend (S3 + DynamoDB lock table) so this
  # is runnable with zero pre-existing infrastructure beyond an AWS
  # account/credentials -- see infra/README.md for how to add one before
  # using this for anything beyond a single-operator trial deployment.
}

provider "aws" {
  region = var.aws_region

  default_tags {
    tags = {
      Project     = var.project_name
      Environment = var.environment
      ManagedBy   = "terraform"
    }
  }
}
