__pycache__/
*.pyc
*.pyo
.pytest_cache/
*.egg-info/
.DS_Store
*.log

# polished report -- kept out of version control intentionally; being
# revised before it's added back in
docs/*.docx
docs/*.pdf

# Terraform runtime state/cache -- never commit state (it can contain
# secret values in plaintext) or the local provider plugin cache.
infra/terraform/.terraform/
infra/terraform/.terraform.lock.hcl
infra/terraform/*.tfstate
infra/terraform/*.tfstate.*
infra/terraform/terraform.tfvars
infra/terraform/build/
.vercel
.env*

# locust per-second history is bulky and only useful while debugging a run;
# the summary stats CSVs (and bench/results/summary.json) are what the
# README cites, so those are committed and the history files are not.
bench/results/*/stats_stats_history.csv
